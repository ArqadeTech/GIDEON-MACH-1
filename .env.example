# ---------------------------------------------------------------------------
# Twilio (voice + SMS)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
MY_PHONE_NUMBER=+15559876543

# Public base URL used in TwiML (ngrok HTTPS URL in local dev, no trailing slash)
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ---------------------------------------------------------------------------
# Gmail API (OAuth2)
# Download OAuth client credentials from Google Cloud Console and place the
# JSON file next to the project (or set an absolute path).
# ---------------------------------------------------------------------------
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify

# Optional: default "from" / reply address shown in logs
GMAIL_USER=me

# ---------------------------------------------------------------------------
# Agent / LLM placeholder
# Wire these to your preferred provider (OpenAI, Anthropic, local, etc.)
# ---------------------------------------------------------------------------
LLM_PROVIDER=placeholder
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true
